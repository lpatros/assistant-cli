# custom/adapters/kimi/init.sh

_engine_kimi_binary() {
  echo "kimi"
}

_engine_kimi_is_installed() {
  _is_installed "kimi"
}

_engine_kimi_list_models() {
  kimi models 2>/dev/null | grep -v '^$' | grep '/'
}

_engine_kimi_run_prompt() {
  local prompt="$1"
  local output_file="$2"
  shift 2 || true

  local model
  model=$(_get_model_for_engine "kimi")

  local args=()
  [[ -z "$model" ]] || args+=(--model "$model")
  args+=(--prompt "$prompt")
  # Choose the CLI mode that emits only its final response.
  _harness_capture_text kimi "$output_file" kimi "${args[@]}"
}

_engine_kimi_run_interactive() {
  local model="$1"
  echo ""
  if [[ ${#LLM_CLEAN_ARGS[@]} -gt 0 ]]; then
    kimi --model "$model" --prompt "${LLM_CLEAN_ARGS[*]}"
  else
    kimi --model "$model"
  fi
}

_engine_kimi_default_model() {
  echo ""
}

# Optional complete declaration. Omitted capabilities mean unsupported.
_engine_kimi_capabilities() {
  printf '%s\n' prompt interactive model_list final_output
}
